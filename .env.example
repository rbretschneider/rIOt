# rIOt Server Configuration
# Copy to .env and edit values before running docker compose up
# Everything else is configured through the setup wizard in the browser.

# PostgreSQL credentials (change the password!)
POSTGRES_USER=riot
POSTGRES_PASSWORD=riot
POSTGRES_DB=riot

# Optional overrides (uncomment if needed)
# RIOT_RETENTION_DAYS=30
# RIOT_ALLOWED_ORIGINS=https://riot.example.com

# Optional: "Sign in with SSO" (OIDC-001). Dormant unless all three of
# RIOT_OIDC_ISSUER_URL, RIOT_OIDC_CLIENT_ID, and RIOT_OIDC_CLIENT_SECRET are
# set. The IdP decides who gets in — bind the rIOt application to a specific
# group in your identity provider before setting these variables, or every
# authenticated user of your IdP will be granted full rIOt admin.
# RIOT_OIDC_ISSUER_URL=https://auth.example.com/application/o/riot/
# RIOT_OIDC_CLIENT_ID=changeme
# RIOT_OIDC_CLIENT_SECRET=changeme
# RIOT_OIDC_BUTTON_LABEL=Sign in with authentik

# Optional: trusted reverse-proxy CIDRs (OIDC-001 AD-020). Default empty
# means forwarding headers (X-Forwarded-For, X-Real-IP, True-Client-IP,
# X-Forwarded-Proto) are ignored entirely — the safe default for rIOt's
# direct-exposure deployment. If rIOt sits behind a TLS-terminating reverse
# proxy, set this to the proxy's CIDR: it is what turns on the Secure
# attribute on the riot_session cookie (without it, X-Forwarded-Proto is
# ignored, rIOt sees a plain-HTTP request, and the cookie ships without
# Secure even though the browser is talking https to your proxy). Leaving
# it unset behind a proxy also collapses per-client rate limiting and
# audit IPs onto the proxy's own address.
# RIOT_TRUSTED_PROXIES=10.0.0.5/32
