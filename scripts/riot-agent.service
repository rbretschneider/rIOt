[Unit]
Description=rIOt Agent - Infrastructure Monitoring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-+/usr/local/lib/riot/riot-agent-apply --boot
ExecStart=/usr/local/bin/riot-agent -config /etc/riot/agent.yaml
Restart=always
RestartSec=5
User=riot
Group=riot
SupplementaryGroups=docker systemd-journal
LimitNOFILE=65536
# Memory limit (GROWTH-001): MemoryMax caps the whole cgroup, GOMEMLIMIT makes
# the Go runtime collect garbage before that, and OOMPolicy=continue keeps one
# OOM-killed process from stopping the unit. Supported apt maintenance runs in
# the independent riot-maintenance.service, outside this cgroup. Legacy/DNF
# package children still inherit this cgroup and can be interrupted with it.
MemoryMax=50%
Environment=GOMEMLIMIT=200MiB
OOMPolicy=continue

# Security hardening
ProtectSystem=strict
ReadWritePaths=/var/lib/riot /etc/riot /usr/local/bin/riot-agent
PrivateTmp=true

[Install]
WantedBy=multi-user.target
